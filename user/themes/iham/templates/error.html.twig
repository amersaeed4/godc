{% extends 'partials/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}
{% block content %}
<section class="section error-page">
  <div class="container container--narrow center">
    <p class="error-code">{{ page.header.http_response_code ?: 404 }}</p>
    <h1>We couldn’t find that page</h1>
    <p class="lead">The page you are looking for may have moved or no longer exists. Try one of these instead.</p>
    <div class="btn-row btn-row--center">
      <a class="btn btn-primary" href="{{ base_url_relative ?: '/' }}">Go to the homepage</a>
      <a class="btn btn-outline" href="{{ '/our-services'|href }}">Our services</a>
      <a class="btn btn-outline" href="{{ '/book-a-consultation'|href }}">Contact us</a>
    </div>
  </div>
</section>
{% endblock %}
