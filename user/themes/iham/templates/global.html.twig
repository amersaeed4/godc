{% extends 'partials/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}
{% block content %}
{% set h = page.header %}
{% set hero = h.hero %}
<section class="page-hero page-hero--image">
  <div class="container page-hero__inner">
    <div class="page-hero__copy">
      {% include 'partials/breadcrumbs.html.twig' %}
      <p class="eyebrow eyebrow--light">{{ hero.eyebrow }}</p>
      <h1>{{ hero.title }}</h1>
      <p class="page-hero__sub">{{ hero.subtitle }}</p>
      <div class="page-hero__lead">{{ hero.text|markdown }}</div>
      {% if hero.button_label %}<div class="btn-row"><a class="btn btn-accent" href="{{ hero.button_link|href }}">{{ hero.button_label }} {{ ui.icon('arrow-right') }}</a></div>{% endif %}
    </div>
    <div class="page-hero__media">{{ ui.img(page, hero.image, hero.title, 'contain', true) }}</div>
  </div>
</section>

<section class="section">
  <div class="container">
    {{ ui.head('Outcomes', h.outcomes.title) }}
    <div class="card-grid card-grid--3">
      {% set icons = ['clipboard', 'building', 'chart', 'book', 'users', 'award', 'shield'] %}
      {% for o in h.outcomes.items %}
      <div class="value-card"><span class="icon-badge">{{ ui.icon(icons[loop.index0] ?? 'check') }}</span><h3>{{ o.title }}</h3><p>{{ o.text }}</p></div>
      {% endfor %}
      {% if h.outcomes.box.title %}
      <div class="highlight-box">
        <h3>{{ h.outcomes.box.title }}</h3>
        <p>{{ h.outcomes.box.text }}</p>
        <a class="btn btn-accent" href="{{ h.outcomes.box.button_link|href }}">{{ h.outcomes.box.button_label }} {{ ui.icon('arrow-right') }}</a>
      </div>
      {% endif %}
    </div>
  </div>
</section>

<section class="section section--mint">
  <div class="container split">
    <div class="split__copy">
      <p class="eyebrow">{{ h.how.eyebrow }}</p>
      <h2>{{ h.how.title }}</h2>
      <p class="lead">{{ h.how.intro }}</p>
      <ol class="steps">{% for it in h.how.items|lines %}<li>{{ it }}</li>{% endfor %}</ol>
    </div>
    <div class="split__media"><div class="media-frame">{{ ui.img(page, h.how.image, h.how.title) }}</div></div>
  </div>
</section>

<section class="section">
  <div class="container">
    {{ ui.head(h.expertise.eyebrow, h.expertise.title) }}
    <ul class="expertise-grid">
      {% for it in h.expertise.items|lines %}<li>{{ ui.icon('check') }}<span>{{ it }}</span></li>{% endfor %}
    </ul>
  </div>
</section>

<section class="section section--cream">
  <div class="container">
    {{ ui.head(h.partners.eyebrow, h.partners.title) }}
    <ul class="pill-list pill-list--center">{% for it in h.partners.items|lines %}<li>{{ it }}</li>{% endfor %}</ul>

    <h3 class="logo-title">{{ h.partners.international_title }}</h3>
    <ul class="logo-grid">
      {% for l in h.partners.international %}<li>{{ ui.img(page, l.image, l.name) }}</li>{% endfor %}
    </ul>
    <h3 class="logo-title">{{ h.partners.national_title }}</h3>
    <ul class="logo-grid">
      {% for l in h.partners.national %}<li>{{ ui.img(page, l.image, l.name) }}</li>{% endfor %}
    </ul>
  </div>
</section>

<section class="section">
  <div class="container container--narrow center">
    {{ ui.head(h.why.eyebrow, h.why.title) }}
    <div class="prose">{{ h.why.text|markdown }}</div>
  </div>
</section>

{% include 'partials/cta-band.html.twig' with {'cta': h.cta} %}

<section class="section section--mint" id="enquiry">
  <div class="container container--narrow">
    {{ ui.head('Enquire', h.enquiry.title) }}
    <div class="form-card">{% include 'partials/form.html.twig' with {'form_name': h.enquiry.form} %}</div>
  </div>
</section>
{% endblock %}
