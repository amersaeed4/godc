{% set theme = config.themes.iham %}
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% include 'partials/seo.html.twig' %}

    <link rel="preload" href="{{ url('theme://fonts/Poppins-400.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ url('theme://fonts/PlayfairDisplay-600.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ url('theme://css/fonts.css') }}?v=1">
    <link rel="stylesheet" href="{{ url('theme://css/theme.css') }}?v={{ theme_version ?? '1' }}">
    <script>document.documentElement.classList.replace('no-js','js')</script>
    {% block head_extra %}{% endblock %}
    {{ assets.css()|raw }}
</head>
<body class="tpl-{{ page.template }}{% if page.home %} is-home{% endif %}">
<a class="skip-link" href="#main">Skip to main content</a>
{% include 'partials/icons.html.twig' %}
{% include 'partials/header.html.twig' %}

<main id="main">
    {% block content %}{% endblock %}
</main>

{% include 'partials/footer.html.twig' %}

{% set cta_link = theme.header.cta_link ?: '/book-a-consultation' %}
<div class="mobile-bar" role="navigation" aria-label="Quick actions">
    <a class="mobile-bar__call" href="tel:{{ theme.contact.phone|tel }}">{% import 'macros/ui.html.twig' as ui %}{{ ui.icon('phone') }} Call</a>
    <a class="mobile-bar__book" href="{{ cta_link|href }}">{{ ui.icon('calendar') }} {{ theme.header.cta_label ?: 'Book an Appointment' }}</a>
</div>

<script src="{{ url('theme://js/theme.js') }}?v=1" defer></script>
{{ assets.js()|raw }}
{% block scripts %}{% endblock %}
</body>
</html>
